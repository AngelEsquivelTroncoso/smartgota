{
  "env": {
    "browser": true,
    "es2022": true
  },
  "globals": {
    "Chart": "readonly",
    "jspdf": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "indent": ["error", 2],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-alert": "warn",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "no-debugger": "warn"
  }
}
