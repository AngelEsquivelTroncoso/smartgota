{
  "name": "smartgota",
  "version": "1.0.0",
  "description": "Simulador de consumo de agua de vivienda - SmartGota (TI2). Proyecto web estático único (index.html + styles.css + app.js).",
  "private": true,
  "scripts": {
    "start": "echo 'Abrir index.html directamente en el navegador (file:// funciona; no hay servidor que levantar).'",
    "lint": "eslint app.js dominio.js",
    "lint:fix": "eslint app.js dominio.js --fix",
    "test": "node --test",
    "format": "prettier --write app.js dominio.js styles.css index.html",
    "format:check": "prettier --check app.js dominio.js styles.css index.html"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2022": true
    },
    "extends": "eslint:recommended",
    "globals": {
      "Chart": "readonly",
      "jspdf": "readonly",
      "module": "readonly"
    },
    "overrides": [
      {
        "files": [
          "dominio.test.js"
        ],
        "env": {
          "node": true
        }
      },
      {
        "files": [
          "app.js"
        ],
        "globals": {
          "SmartGotaDominio": "readonly"
        }
      }
    ],
    "rules": {
      "no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "no-alert": "warn"
    }
  }
}
